From: enfs-dkms
Subject: [PATCH] include/linux/sunrpc/clnt.h: add cl_enfs + multipath_option (rpc_clnt + rpc_create_args)

OpenEuler's enfs adds three fields, all guarded by CONFIG_SUNRPC_ENFS:

  - struct rpc_clnt::cl_enfs (1-bit) — set when this client has enfs
    multipath enabled.
  - struct rpc_clnt::multipath_option — opaque pointer to enfs's
    per-client multipath state.
  - struct rpc_create_args::multipath_option — passed in by enfs at
    client-creation time so rpc_multipath_ops_create_clnt() can attach
    state to the new rpc_clnt.

OE 6.6 reused KABI_RESERVE slots; Ubuntu 7.0 doesn't carry KABI
reservation, so we just append the fields. Acceptable for an
out-of-tree replacement of sunrpc.ko (we control all consumers).

NOTE: rpc_create_args.multipath_option was missed in the first cut of
this patch — added now.

---
--- a/include/linux/sunrpc/clnt.h
+++ b/include/linux/sunrpc/clnt.h
@@ -65,6 +65,9 @@
 				cl_autobind : 1,/* use getport() */
 				cl_chatty   : 1,/* be verbose */
 				cl_shutdown : 1,/* rpc immediate -EIO */
+#if IS_ENABLED(CONFIG_SUNRPC_ENFS)
+				cl_enfs     : 1,/* enfs multipath enabled */
+#endif
 				cl_netunreach_fatal : 1;
 						/* Treat ENETUNREACH errors as fatal */
 	struct xprtsec_parms	cl_xprtsec;	/* transport security policy */
@@ -96,6 +99,9 @@
 	unsigned int		cl_max_connect; /* max number of transports not to the same IP */
 	struct super_block *pipefs_sb;
 	atomic_t		cl_task_count;
+#if IS_ENABLED(CONFIG_SUNRPC_ENFS)
+	void			*multipath_option;
+#endif
 };
 
 /*
@@ -155,6 +161,9 @@
 	struct xprtsec_parms	xprtsec;
 	unsigned long		connect_timeout;
 	unsigned long		reconnect_timeout;
+#if IS_ENABLED(CONFIG_SUNRPC_ENFS)
+	void			*multipath_option;	/* enfs: opaque parsed enfs_info= */
+#endif
 };
 
 struct rpc_add_xprt_test {

From: enfs-dkms
Subject: [PATCH] fs/nfs/fs_context.c: add enfs_info= / remoteaddrs= / localaddrs= mount options

Wire the enfs multipath mount syntax through the NFS fs_context parser.
Seven hook sites, all guarded by CONFIG_ENFS:

  1. Include enfs_adapter.h.

  2. Extend the Opt_* enum with the 5 new tokens
     (Opt_remote_addrs, Opt_local_iplist, Opt_enfs_info,
     Opt_slookupcache, Opt_alookupcache).

  3. Extend the nfs_fs_parameters[] table with matching fsparam_string
     entries so the new tokens are accepted by the generic mount-option
     parser.

  4. Add the small helper getNfsMultiPathOpt() that maps the parser's
     opcode back to the (REMOTEADDR / LOCALADDR / INVALID_OPTION)
     enum used by enfs_parse_mount_options().

  5. Handle the new tokens inside nfs_fs_context_parse_param():
     - remote_addrs / local_iplist → enfs_parse_mount_options()
     - enfs_info / slookupcache / alookupcache → accepted but
       deferred to enfs's own remount-time logic (no-op here).
     Add two new error labels (out_limit, out_nomem) for the parser
     return paths.

  6. In nfs_validate_text_mount_data() — after nfs_parse_source() has
     populated ctx->nfs_server.hostname — call
     nfs_multipath_set_mount_data() so enfs sees the resolved hostname
     before nfs_mod loading kicks off.

  7. In the fs_context constructor: initialise ctx->enfs_option to NULL.
     In nfs_fs_context_free(): call enfs_free_mount_options(ctx) before
     kfree-ing the context (it owns its own freeing under enfs's
     storage rules; safe to call when option is NULL).

This is the largest patch in the series. Each hook site is small and
mechanical; together they account for the full enfs_info= mount syntax.

---
 fs/nfs/fs_context.c | 87 +++++++++++++++++++++++++++++++++++++++++++++
--- a/fs/nfs/fs_context.c
+++ b/fs/nfs/fs_context.c
@@ -24,6 +24,9 @@
 #include "nfs.h"
 #include "internal.h"
 
+#if IS_ENABLED(CONFIG_ENFS)
+#include "enfs_adapter.h"
+#endif
 #include "nfstrace.h"
 
 #define NFSDBG_FACILITY		NFSDBG_MOUNT
@@ -98,6 +101,13 @@
 	Opt_xprtsec,
 	Opt_cert_serial,
 	Opt_privkey_serial,
+#if IS_ENABLED(CONFIG_ENFS)
+	Opt_remote_addrs,
+	Opt_local_iplist,
+	Opt_enfs_info,
+	Opt_slookupcache,
+	Opt_alookupcache,
+#endif
 };
 
 enum {
@@ -225,6 +235,13 @@
 	fsparam_string("xprtsec",	Opt_xprtsec),
 	fsparam_s32("cert_serial",	Opt_cert_serial),
 	fsparam_s32("privkey_serial",	Opt_privkey_serial),
+#if IS_ENABLED(CONFIG_ENFS)
+	fsparam_string("localaddrs",	Opt_local_iplist),
+	fsparam_string("remoteaddrs",	Opt_remote_addrs),
+	fsparam_string("enfs_info",	Opt_enfs_info),
+	fsparam_string("slookupcache",	Opt_slookupcache),
+	fsparam_string("alookupcache",	Opt_alookupcache),
+#endif
 	{}
 };
 
@@ -493,6 +510,21 @@
 	return 0;
 }
 
+#if IS_ENABLED(CONFIG_ENFS)
+enum nfsmultipathoptions getNfsMultiPathOpt(int token)
+{
+	switch (token) {
+	case Opt_remote_addrs:
+		return REMOTEADDR;
+	case Opt_local_iplist:
+		return LOCALADDR;
+	default:
+		break;
+	}
+	return INVALID_OPTION;
+}
+#endif
+
 static int nfs_parse_xprtsec_policy(struct fs_context *fc,
 				    struct fs_parameter *param)
 {
@@ -1039,6 +1071,28 @@
 	case Opt_sloppy:
 		ctx->sloppy = true;
 		break;
+#if IS_ENABLED(CONFIG_ENFS)
+	case Opt_local_iplist:
+	case Opt_remote_addrs:
+		switch (enfs_parse_mount_options(getNfsMultiPathOpt(opt),
+						 param->string, ctx, fc)) {
+		case 0:
+			break;
+		case -ENOMEM:
+			goto out_nomem;
+		case -ENOSPC:
+			goto out_limit;
+		case -EINVAL:
+			goto out_invalid_address;
+		case -EOPNOTSUPP:
+			goto out_invalid_address;
+		}
+		break;
+	case Opt_enfs_info:
+	case Opt_slookupcache:
+	case Opt_alookupcache:
+		break;
+#endif
 	}
 
 	return 0;
@@ -1051,6 +1105,12 @@
 	return nfs_invalf(fc, "NFS: Value for '%s' out of range", param->key);
 out_bad_transport:
 	return nfs_invalf(fc, "NFS: Unrecognized transport protocol");
+#if IS_ENABLED(CONFIG_ENFS)
+out_limit:
+	return nfs_invalf(fc, "NFS: param is more than supported limit");
+out_nomem:
+	return nfs_invalf(fc, "NFS: not enough memory to parse option");
+#endif
 }
 
 /*
@@ -1567,6 +1627,9 @@
 	if (ret < 0)
 		return ret;
 
+#if IS_ENABLED(CONFIG_ENFS)
+	nfs_multipath_set_mount_data(&ctx->enfs_option, ctx->nfs_server.hostname);
+#endif
 	/* Load the NFS protocol module if we haven't done so yet */
 	if (!ctx->nfs_mod) {
 		nfs_mod = find_nfs_version(ctx->version);
@@ -1650,6 +1713,9 @@
 	ctx->nfs_server.hostname	= NULL;
 	ctx->fscache_uniq		= NULL;
 	ctx->clone_data.fattr		= NULL;
+#if IS_ENABLED(CONFIG_ENFS)
+	ctx->enfs_option		= NULL;
+#endif
 	fc->fs_private = ctx;
 	return 0;
 }
@@ -1668,6 +1734,9 @@
 		kfree(ctx->nfs_server.export_path);
 		kfree(ctx->nfs_server.hostname);
 		kfree(ctx->fscache_uniq);
+#if IS_ENABLED(CONFIG_ENFS)
+		enfs_free_mount_options(ctx);
+#endif
 		nfs_free_fhandle(ctx->mntfh);
 		nfs_free_fattr(ctx->clone_data.fattr);
 		kfree(ctx);

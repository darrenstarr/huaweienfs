From: enfs-dkms
Subject: [PATCH] include/linux/nfs_fs_sb.h: add enfs fields, hidden from genksyms

Three additions:
  - struct nfs_client::cl_multipath_data
  - struct nfs_server::enfs_flags
  - static-inline refcount helpers nfsclient_refinc/refdec

All wrapped in `#if !defined(__GENKSYMS__) && IS_ENABLED(CONFIG_ENFS)`
so genksyms generates the SAME CRCs for nfs.ko's exported symbols as
stock Ubuntu — keeping unmodified consumers (nfs_acl, nfsd, lockd,
nfsv3.ko, nfsv4.ko) loadable against our patched nfs.ko.

The new pointer/int fields sit AFTER the original last field in each
struct so accesses by stock callers stay at correct offsets; only our
patched code reaches the appended fields.

---
--- a/include/linux/nfs_fs_sb.h
+++ b/include/linux/nfs_fs_sb.h
@@ -127,6 +127,9 @@
 	struct list_head	pending_cb_stateids;
 	struct rcu_head		rcu;
 
+#if !defined(__GENKSYMS__) && IS_ENABLED(CONFIG_ENFS)
+	void			*cl_multipath_data; /* hidden from genksyms */
+#endif
 #if IS_ENABLED(CONFIG_NFS_LOCALIO)
 	struct timespec64	cl_nfssvc_boot;
 	seqlock_t		cl_boot_lock;
@@ -296,6 +299,9 @@
 	bool			has_sec_mnt_opts;
 	struct kobject		kobj;
 	struct rcu_head		rcu;
+#if !defined(__GENKSYMS__) && IS_ENABLED(CONFIG_ENFS)
+	int			enfs_flags;	/* hidden from genksyms */
+#endif
 };
 
 /* Server capabilities */
@@ -331,4 +337,20 @@
 #define NFS_CAP_READ_PLUS	(1U << 29)
 #define NFS_CAP_FS_LOCATIONS	(1U << 30)
 #define NFS_CAP_MOVEABLE	(1U << 31)
+
+#if !defined(__GENKSYMS__) && IS_ENABLED(CONFIG_ENFS)
+/* Hidden from genksyms: these helpers are inline-only and don't appear
+ * as exported symbols, so the only "CRC" effect would be through
+ * function-signature mention — which doesn't apply to static inlines.
+ * Still wrap for symmetry with the struct additions above. */
+static inline void nfsclient_refinc(refcount_t *ref_count)
+{
+	refcount_inc(ref_count);
+}
+
+static inline void nfsclient_refdec(refcount_t *ref_count)
+{
+	refcount_dec(ref_count);
+}
+#endif
 #endif

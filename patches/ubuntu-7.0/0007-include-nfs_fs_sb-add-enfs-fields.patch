From: enfs-dkms
Subject: [PATCH] include/linux/nfs_fs_sb.h: add enfs fields and helpers

Three additions, all guarded by CONFIG_ENFS:

  1. struct nfs_client gains `cl_multipath_data` — opaque pointer to
     the per-client `multipath_client_info` that enfs_multipath_client.c
     manages. Populated by enfs_adapter when a client is created with
     enfs_info=, NULL otherwise.

  2. struct nfs_server gains `enfs_flags` — bitmap of
     `ENFS_SERVER_FLAG_*` (see fs/nfs/enfs/enfs.h). enfs uses this to
     track per-server multipath state.

  3. Two static inlines `nfsclient_refinc` / `nfsclient_refdec` —
     thin wrappers around `refcount_inc`/`refcount_dec` for the
     `clp_count` field. enfs needs them to bump the refcount from its
     out-of-tree code without poking refcount internals.

Each block is appended at the natural insertion point in Ubuntu 7.0's
file (which has different cap-bit numbering than OE 6.6, so we don't
follow OE's exact placement).

---
--- a/include/linux/nfs_fs_sb.h
+++ b/include/linux/nfs_fs_sb.h
@@ -127,6 +127,9 @@
 	struct list_head	pending_cb_stateids;
 	struct rcu_head		rcu;
 
+#if IS_ENABLED(CONFIG_ENFS)
+	void			*cl_multipath_data; /* struct multipath_client_info * */
+#endif
 #if IS_ENABLED(CONFIG_NFS_LOCALIO)
 	struct timespec64	cl_nfssvc_boot;
 	seqlock_t		cl_boot_lock;
@@ -296,6 +299,9 @@
 	bool			has_sec_mnt_opts;
 	struct kobject		kobj;
 	struct rcu_head		rcu;
+#if IS_ENABLED(CONFIG_ENFS)
+	int			enfs_flags;	/* ENFS_SERVER_FLAG_xx (fs/nfs/enfs/enfs.h) */
+#endif
 };
 
 /* Server capabilities */
@@ -331,4 +337,17 @@
 #define NFS_CAP_READ_PLUS	(1U << 29)
 #define NFS_CAP_FS_LOCATIONS	(1U << 30)
 #define NFS_CAP_MOVEABLE	(1U << 31)
+
+#if IS_ENABLED(CONFIG_ENFS)
+/* Refcount helpers used by out-of-tree enfs sources to bump clp_count. */
+static inline void nfsclient_refinc(refcount_t *ref_count)
+{
+	refcount_inc(ref_count);
+}
+
+static inline void nfsclient_refdec(refcount_t *ref_count)
+{
+	refcount_dec(ref_count);
+}
+#endif
 #endif

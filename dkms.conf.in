# DKMS manifest for enfs-dkms.
#
# This file is the template; @VERSION@ is substituted by `make dkms-conf`
# (or by debian/rules at package-build time) using the version from
# debian/changelog.
#
# This DKMS module produces SEVEN kernel objects:
#
# Legacy stack (replaces the host's in-tree NFS client modules — to be
# retired once the clean stack reaches feature parity, see
# docs/internals/15-esunrpc-fork.md §15.8 / PR 7):
#
#   net/sunrpc/sunrpc.ko    stock SunRPC + sunrpc_enfs_adapter.o
#   fs/nfs_common/nfs_acl.ko  rebuilt against our patched sunrpc CRCs
#   fs/lockd/lockd.ko       rebuilt against our patched sunrpc CRCs
#   fs/nfs/nfs.ko           stock NFS client + enfs_adapter.o
#   fs/nfs/nfsv3.ko         NFSv3 procedure table + enfs EXTEND op
#   fs/nfs/enfs/enfs.ko     the multipath module
#
# Clean stack (additive, coexists with stock kernel modules):
#
#   net/esunrpc/esunrpc.ko  forked client-side SunRPC; every exported
#                           symbol renamed to esunrpc_* so it does not
#                           collide with stock sunrpc.ko. PR 1 of the
#                           clean-stack roadmap; see chapter 15.
#
# DKMS installs them under /lib/modules/$kernelver/updates/, which
# `depmod` ranks higher than kernel/, so subsequent modprobe always
# loads our copies. `dkms remove` deletes from updates/ and the stock
# modules become primary again — full rollback.

PACKAGE_NAME="enfs"
PACKAGE_VERSION="@VERSION@"

# The kernel build descends into our top-level src/Kbuild (which the
# `make port` step has just dropped into the staged source dir).
MAKE[0]="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build/src modules"
CLEAN="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build/src clean"

# A pre-build hook runs `make port` so src/ is materialised from the
# vendored sources + patches. DKMS runs this from the staged dir.
PRE_BUILD="scripts/dkms-pre-build.sh"

# Built modules and their install destinations under /lib/modules/$kver/.
# Order is significant for modprobe load: sunrpc first, enfs last.
# All go to /updates/ so depmod ranks them above /kernel/.

# BUILT_MODULE_LOCATION is where DKMS finds the .ko after the build.
# Top-level Kbuild has `obj-m += sunrpc.o` (and nfs.o) so those .ko
# land at the top of build/src/. Subdir descents (lockd, nfs_acl,
# nfsv3, enfs) keep their relative subdirectory.
BUILT_MODULE_NAME[0]="sunrpc"
BUILT_MODULE_LOCATION[0]="src"
DEST_MODULE_LOCATION[0]="/updates"

BUILT_MODULE_NAME[1]="nfs_acl"
BUILT_MODULE_LOCATION[1]="src/fs/nfs_common"
DEST_MODULE_LOCATION[1]="/updates"

BUILT_MODULE_NAME[2]="lockd"
BUILT_MODULE_LOCATION[2]="src/fs/lockd"
DEST_MODULE_LOCATION[2]="/updates"

BUILT_MODULE_NAME[3]="nfs"
BUILT_MODULE_LOCATION[3]="src"
DEST_MODULE_LOCATION[3]="/updates"

BUILT_MODULE_NAME[4]="nfsv3"
BUILT_MODULE_LOCATION[4]="src/fs/nfs"
DEST_MODULE_LOCATION[4]="/updates"

BUILT_MODULE_NAME[5]="enfs"
BUILT_MODULE_LOCATION[5]="src/fs/nfs/enfs"
DEST_MODULE_LOCATION[5]="/updates"

BUILT_MODULE_NAME[6]="esunrpc"
BUILT_MODULE_LOCATION[6]="src/net/esunrpc"
DEST_MODULE_LOCATION[6]="/updates"

# Rebuild on every kernel update.
AUTOINSTALL="yes"

# Refresh the initramfs after install/remove because root-on-NFS hosts
# pull nfs/sunrpc into the initramfs and would otherwise still load the
# stock copies at boot.
REMAKE_INITRD="yes"

# Match the OpenEuler Kconfig (see vendor/openeuler/fs/nfs/Kconfig).
BUILD_EXCLUSIVE_ARCH="x86_64|aarch64"

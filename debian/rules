#!/usr/bin/make -f
# debian/rules for enfs-dkms — source-only DKMS package.
#
# We ship the project tree under /usr/src/enfs-<ver>/ and let DKMS
# rebuild from source via the PRE_BUILD hook on every kernel update.

include /usr/share/dpkg/pkg-info.mk

DKMS_SRC = $(CURDIR)/debian/enfs-dkms/usr/src/enfs-$(DEB_VERSION_UPSTREAM)

%:
	dh $@ --with dkms

override_dh_auto_build:
	# DKMS modules don't build at packaging time; the kernel build
	# happens on the user's machine via DKMS. We generate two files
	# from dkms.conf.in (the single source of truth):
	#
	#   dkms.conf              — used by `make dkms-install` (local
	#                            install path); literal version from
	#                            $(DEB_VERSION_UPSTREAM) substituted in
	#                            for @VERSION@.
	#
	#   debian/enfs-dkms.dkms  — read by dh_dkms during this build; we
	#                            keep `#MODULE_VERSION#` in place so
	#                            dh_dkms substitutes it itself at install
	#                            time. This becomes /usr/src/enfs-<ver>/
	#                            dkms.conf inside the .deb.
	sed 's|@VERSION@|$(DEB_VERSION_UPSTREAM)|g' dkms.conf.in > dkms.conf
	sed 's|@VERSION@|#MODULE_VERSION#|g'        dkms.conf.in > debian/enfs-dkms.dkms

override_dh_auto_install:
	mkdir -p $(DKMS_SRC)
	# Stage what DKMS needs to rebuild against any kernel:
	#   vendor/    Ubuntu + OpenEuler kernel sources we patch
	#   patches/   patch series applied at PRE_BUILD time
	#   compat/    kernel-version shim header
	#   scripts/   build-src-tree.sh + dkms-pre-build.sh + sync helpers
	#   Kbuild     top-level out-of-tree build entry
	#   Makefile   (informational; DKMS calls $(MAKE) directly via dkms.conf)
	#   README, LICENSE, docs/  (small, useful for inspecting the staged tree)
	#
	# dkms.conf itself is installed by dh_dkms (from the file we just
	# generated at debian/enfs-dkms.dkms), with #MODULE_VERSION#
	# substituted, into /usr/src/enfs-<ver>/dkms.conf.
	#
	# Explicitly NOT shipped:
	#   src/       (regenerated each rebuild by the PRE_BUILD hook)
	#   debian/    (already installed via dpkg, would be circular)
	#   secrets/, CLAUDE.md, .git, .github/  (developer state)
	#   any *.ko / *.o / Module.symvers (build artefacts)
	cp -a vendor patches compat scripts Kbuild Makefile \
	      README.md LICENSE docs $(DKMS_SRC)/

override_dh_auto_clean:
	rm -f dkms.conf debian/enfs-dkms.dkms
	rm -rf $(CURDIR)/src/.build-stamp

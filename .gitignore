# =====================================================================
# PRIVACY: keep local-only state out of the public repo.
# =====================================================================

# Local AI/agent guidance + per-user notes — may contain real hostnames,
# IPs, credentials, or other deployment-specific info we never want in
# the public repo. The public-facing equivalent for AI agents is in
# docs/ai-agent-guide.md.
CLAUDE.md
GEMINI.md
COPILOT.md
AGENT.md
.cursorrules
.cursor/
.aider*
.claude/
.continue/

# Real values for hosts/IPs/credentials used by *this* developer's
# reference deployment. Public docs reference these by placeholder.
secrets/

# Local environment overrides for the Makefile (VM_HOST, KDIR, etc.).
.env
.env.local
config.local

# =====================================================================
# Generated build state.
# =====================================================================

# Generated by `make port`.
src/

# Generated by `make manpage` from docs/man/*.md sources.
docs/man/enfs.7
docs/man/esunrpc.7
docs/man/esunrpc_*.3

# Materialised by `scripts/fetch-vendor-ubuntu.sh` from the upstream
# Ubuntu kernel source package. Only UPSTREAM-REVISION (the pin) and
# MANIFEST (the path list) are tracked; everything else under the
# vendor/ubuntu-X.Y/ subtree is regenerated.
vendor/ubuntu-*/*
!vendor/ubuntu-*/UPSTREAM-REVISION
!vendor/ubuntu-*/MANIFEST

# Userspace test build state. Headers are fetched from upstream by
# tests/fetch-linux-headers.sh; binaries and intermediates are
# regenerated by `make test`. UPSTREAM-REVISION and
# LINUX-HEADERS-MANIFEST (the only inputs) ARE tracked.
tests/build/
tests/*.gcov
*.gcda
*.gcno

# Generated by `make dkms-conf` / debian/rules.
dkms.conf

# Kernel build artefacts.
*.o
*.ko
*.mod
*.mod.c
*.mod.o
*.cmd
.*.cmd
.tmp_versions/
Module.symvers
modules.order

# Debian build artefacts.
debian/.debhelper/
debian/files
debian/enfs-dkms/
debian/*.substvars
debian/*.log
debian/debhelper-build-stamp

# Editor / OS noise.
*.swp
*~
.DS_Store
/debian/enfs-dkms.dkms
